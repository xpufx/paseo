{
  "name": "@xpufx/paseo",
  "version": "0.1.0",
  "description": "Monorepo for xpufx Paseo tooling: shared plugin helper, Paseo plugins, MCP servers, and agent skills",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/paseo-plugin-helper",
    "plugins/top",
    "plugins/mcp-tools",
    "plugins/x-comms",
    "plugins/forges",
    "plugins/demo",
    "plugins/slash",
    "plugins/plugin-updates",
    "plugins/twofado",
    "plugins/uppidi-fleet",
    "plugins/worktree-install",
    "plugins/wellbeing"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:declared-tooling": "node --test scripts/declared-tooling.test.mjs",
    "check:fixture-home-paths": "node --test scripts/fixture-home-paths.test.mjs",
    "check:helper-resolution": "node --test scripts/helper-resolution.test.mjs",
    "check:npm-acquisition-coverage": "node --test scripts/npm-acquisition-coverage.test.mjs",
    "check:reload-notify": "node scripts/reload-notify.test.mjs",
    "check:unreachable-tests": "node --test scripts/unreachable-tests.test.mjs",
    "test": "npm run check:fixture-home-paths && npm run check:declared-tooling && npm run check:helper-resolution && npm run check:npm-acquisition-coverage && npm run check:reload-notify && npm run check:unreachable-tests && npm run test --workspaces --if-present",
    "test:npm-acquisition": "node scripts/npm-acquisition-smoke.mjs",
    "doctor:live": "node scripts/doctor-live.mjs"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@forge.mrs.uppidi.com:222/xpufx/paseo.git"
  },
  "license": "MIT"
}
