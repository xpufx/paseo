node_modules/
*.log

# Stray lockfiles (this repo uses npm; package-lock.json is authoritative)
pnpm-lock.yaml
yarn.lock

# OS & editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Secrets & credentials
.env*
!.env.example
*.pem
*.key
*.id_rsa
.npmrc
*credentials*.json

# Runtime daemon & scratch files
.paseo/
*.sock
*.pid
state/

# Staged npm publish artifacts (agent/CI upload; never committed)
publish-stage/

# Build & test caches
*.tsbuildinfo
.turbo/
coverage/
.vitest/

# Plugin build artifacts (scoped — helper dist stays tracked for package exports)
dist/
!packages/paseo-plugin-helper/dist/
plugins/*/dist/

# Self-installed companion binaries (acquired in-process from releases)
plugins/*/bin/

# Local agent guidance (per-machine, never committed)
packages/paseo-plugin-helper/AGENTS.md
.agents/
.verify-tmp/

# Vendor link-mode stash (dev-only, never committed — materialize before publish)
*.link-bak/

# Local opencode config (per-machine, never committed)
opencode.jsonc

# Serena per-project state (memories, caches — per-machine, never committed)
.serena/
scratch/
