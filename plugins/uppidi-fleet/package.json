{
  "name": "@xpufx/paseo-uppidi-fleet",
  "version": "0.1.0",
  "description": "Full-lifecycle autonomous engineering fleet for Paseo",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "stamp": "node -e \"import('../../packages/paseo-plugin-helper/src/server/version.ts').then(m => m.stampVersion({ targetFile: 'shared/version.ts' }))\"",
    "test": "npm run typecheck && npm run test:node && npm run test:tsx",
    "test:node": "NODE_ENV=test node --import ./test/register-ts-hooks.mjs --test shared/contracts.test.ts shared/sort-filter.test.ts server/hook.test.ts server/fleet.test.ts server/agents.test.ts server/metrics.test.ts server/hook-router.test.ts server/runners.test.ts",
    "test:tsx": "NODE_ENV=test tsx --test client/entry.test.ts client/mobile-layout.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.9.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "^19.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "files": [
    "paseo-plugin.json",
    "README.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "!client/testing",
    "server",
    "shared",
    "docs",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.mjs",
    "!**/.DS_Store"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpufx/paseo.git"
  }
}
