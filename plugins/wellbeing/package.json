{
  "name": "@xpufx/paseo-wellbeing",
  "version": "0.2.1",
  "description": "Operator presence tracking, circadian schedule management, and fatigue/wind-down alerting for Paseo",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npx tsx --test server/presence.test.ts client/entry.test.ts && vitest run client/surface.test.tsx"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.9.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "^19.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  },
  "files": [
    "paseo-plugin.json",
    "README.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.mjs",
    "!**/.DS_Store"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpufx/paseo.git"
  }
